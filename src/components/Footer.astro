---
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import { revision } from '../lib/links';
---

<footer class="lab-footer" data-pagefind-ignore>
  <Pagination />
  <div class="source-note">
    <span>DEV505 / SOUND LAB</span>
    <span>Checked with Unity 6000.6.0f1 · Revision {revision.slice(0, 7)}</span>
  </div>
</footer>
<script>
  // A wide table must also be scrollable by keyboard, including after text zoom.
  const tables = document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table');
  const updateTable = (table: HTMLTableElement) => {
    if (table.scrollWidth > table.clientWidth) table.tabIndex = 0;
    else table.removeAttribute('tabindex');
  };
  const observer = new ResizeObserver((entries) => {
    for (const { target } of entries) updateTable(target as HTMLTableElement);
  });
  tables.forEach((table) => {
    updateTable(table);
    observer.observe(table);
  });
</script>
