---
import DemoCarousel from './DemoCarousel.astro';
import { sitePath } from '../lib/links';
---

<section class="home-hero">
  <div class="hero-copy">
    <p class="page-kicker">DEV505 / SOUND LAB</p>
    <h1 id="_top">
      A little sound.
      <br />
      <span>A lot of life.</span>
    </h1>
    <p class="hero-description">
      Give your world a voice. Build sounds in graphs, bring them to life in code, and learn by
      playing.
    </p>
    <div class="hero-actions">
      <a class="button-primary" href={sitePath('getting-started/')}>
        Make your first sound <span aria-hidden="true">→</span>
      </a>
      <a class="button-text" href={sitePath('api/sound-bus/')}>
        Explore the API ↗
      </a>
    </div>
    <p class="hero-footnote">Made for Unity. Explained one small scene at a time.</p>
  </div>
  <DemoCarousel />
</section>
