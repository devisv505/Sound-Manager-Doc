---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  id: string;
  eager?: boolean;
  compact?: boolean;
  showZoomLabel?: boolean;
}
const { src, alt, caption, id, eager = false, compact = false, showZoomLabel = true } = Astro.props;
const full = await getImage({ src, format: 'webp', quality: compact ? 100 : 94 });
---

<figure class="screenshot" id={id}>
  <button
    class="image-open"
    type="button"
    aria-label={`Enlarge image: ${alt}`}
    aria-haspopup="dialog"
    data-image-open={id + '-dialog'}
  >
    <Image
      src={src}
      alt={alt}
      width={Math.min(1280, src.width)}
      widths={[
        ...new Set([...(compact ? [240, 360, 480] : []), 640, 960, 1280, 1920, src.width]),
      ].filter((w) => w <= src.width && w <= 1920)}
      sizes={compact ? '(min-width: 50rem) 420px, 90vw' : '(min-width: 80rem) 850px, 100vw'}
      format="webp"
      quality={compact ? 100 : 88}
      loading={eager ? 'eager' : 'lazy'}
    />
    {showZoomLabel && (
      <span class="zoom-label" aria-hidden="true">
        ↗ Enlarge
      </span>
    )}
  </button>
  <figcaption>{caption}</figcaption>
  <dialog id={id + '-dialog'} aria-label={alt} class="image-dialog">
    <div class="image-toolbar">
      <button type="button" class="image-size" aria-pressed="false">
        View actual size
      </button>
      <button type="button" class="image-close" autofocus>
        Close <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="image-viewport" tabindex="0" role="region" aria-label="Enlarged screenshot">
      <img src={full.src} width={src.width} height={src.height} alt={alt} loading="lazy" />
    </div>
    <p>{caption}</p>
  </dialog>
</figure>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-image-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.imageOpen!) as HTMLDialogElement;
    const viewport = dialog.querySelector<HTMLElement>('.image-viewport')!;
    const sizeButton = dialog.querySelector<HTMLButtonElement>('.image-size')!;
    const resetView = () => {
      viewport.scrollTop = 0;
      viewport.scrollLeft = 0;
    };
    button.addEventListener('click', () => {
      dialog.classList.remove('is-actual-size');
      sizeButton.setAttribute('aria-pressed', 'false');
      sizeButton.textContent = 'View actual size';
      dialog.showModal();
      resetView();
      document.body.classList.add('image-modal-open');
    });
    dialog.querySelector('.image-close')!.addEventListener('click', () => dialog.close());
    sizeButton.addEventListener('click', () => {
      const actual = dialog.classList.toggle('is-actual-size');
      sizeButton.setAttribute('aria-pressed', String(actual));
      sizeButton.textContent = actual ? 'Fit to window' : 'View actual size';
      resetView();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.classList.remove('image-modal-open');
      button.focus();
    });
  });
</script>
