---
import type { ImageMetadata } from 'astro';
import Screenshot from './Screenshot.astro';
import manifest from '../../content-data/captures.json';
interface Props {
  demo: string;
  group: 'game' | 'editor';
}
const { demo, group } = Astro.props;
const sources = import.meta.glob<{ default: ImageMetadata }>('../assets/demos/**/*.png', {
  eager: true,
});
const captures = manifest.captures.filter(
  (capture) =>
    capture.demo === demo &&
    capture.hudIncluded === (group === 'game') &&
    (group === 'game' ? capture.kind === 'game-view' : capture.kind !== 'game-view'),
);
---

{captures.length > 3 && (
  <nav class="capture-jumps" aria-label={`${group === 'game' ? 'Scene' : 'Editor'} views`}>
    <p>Jump to a view:</p>
    <ul>
      {captures.map((capture) => (
        <li>
          <a href={`#${capture.id}-title`}>{capture.state}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

{captures.map((capture) => {
  const source = sources[capture.publishedSource.replace('src/', '../')];
  if (!source) throw new Error(`Missing capture image: ${capture.publishedSource}`);
  return (
    <section class="capture-entry" aria-labelledby={`${capture.id}-title`}>
      <h3 id={`${capture.id}-title`}>{capture.state}</h3>
      <Screenshot
        src={source.default}
        id={capture.id}
        alt={capture.alt}
        caption={capture.caption}
      />
      <details class="capture-steps">
        <summary>Try this in Unity</summary>
        <ol>
          {capture.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </details>
    </section>
  );
})}
