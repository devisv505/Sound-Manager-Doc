---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import demos from '../../content-data/demos.json';
import manifest from '../../content-data/captures.json';
import { sitePath } from '../lib/links';
const sources = import.meta.glob<{ default: ImageMetadata }>('../assets/demos/**/*.png', {
  eager: true,
});
const heroes: Record<string, string> = {
  '01-campfire': 'lit',
  '02-footstep': 'grass',
  '03-bee': 'flight-right',
  '04-engine': 'driving',
  '05-weather': 'lightning',
  '06-workshop': 'hammer-over-saw',
  '07-arcade': 'chaos',
  '08-jukebox': 'crossfade',
  '09-portals': 'cove',
  '10-launch': 'flight',
};
---

<div class="demo-grid capture-gallery">
  {demos.map((demo) => {
    const captures = manifest.captures.filter(
      (capture) =>
        capture.demo === demo.slug && (capture.hudIncluded || capture.kind !== 'game-view'),
    );
    const hero = captures.find((capture) => capture.original.endsWith(`/${heroes[demo.slug]}.png`));
    if (!hero) throw new Error(`Missing capture preview for ${demo.slug}`);
    const source = sources[hero.publishedSource.replace('src/', '../')].default;
    return (
      <article class="demo-card is-ready">
        <a
          class="capture-preview"
          href={sitePath(`captures/${demo.slug}/`)}
          aria-label={`See ${demo.name} screenshots`}
        >
          <Image
            src={source}
            alt={hero.alt}
            width={800}
            widths={[480, 800]}
            sizes="(min-width: 60rem) 30vw, 100vw"
            format="webp"
            quality={85}
            loading="lazy"
          />
        </a>
        <span class="feature-label">
          {demo.number} / {demo.feature}
        </span>
        <h3>
          <a href={sitePath(`captures/${demo.slug}/`)}>
            {demo.name} <span aria-hidden="true">↗</span>
          </a>
        </h3>
        <p>
          {demo.title} {captures.filter((c) => c.kind === 'game-view').length} scene states and{' '}
          {captures.filter((c) => c.kind !== 'game-view').length} editor{' '}
          {captures.filter((c) => c.kind !== 'game-view').length === 1 ? 'view' : 'views'}.
        </p>
      </article>
    );
  })}
</div>
